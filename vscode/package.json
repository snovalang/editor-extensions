{
    "name": "snovalang",
    "displayName": "Snovalang",
    "description": "Rich language support and IDE-agnostic LSP client for Snovalang",
    "version": "0.1.0",
    "publisher": "aggitech",
    "repository": {
        "type": "git",
        "url": "https://github.com/snovalang/editor-extensions.git"
    },
    "bugs": {
        "url": "https://github.com/snovalang/editor-extensions/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Snippets"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:snova",
        "onLanguage:snova-manifest",
        "workspaceContains:**/mod.sno",
        "workspaceContains:**/snova.sno",
        "workspaceContains:**/snova.toml"
    ],
    "contributes": {
        "languages": [
            {
                "id": "snova",
                "aliases": ["Snovalang", "snova"],
                "extensions": [".snova", ".sno"],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "snova-manifest",
                "aliases": ["Snovalang Manifest", "mod.sno"],
                "filenames": ["mod.sno", "snova.mod", "snova.sno", "snova.toml", "Snovalang.toml"]
            }
        ],
        "grammars": [
            {
                "language": "snova",
                "scopeName": "source.snova",
                "path": "./syntaxes/snovalang.tmLanguage.json"
            },
            {
                "language": "snova-manifest",
                "scopeName": "source.snova.manifest",
                "path": "./syntaxes/snovalang-manifest.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "snova",
                "path": "./snippets/snovalang.json"
            }
        ],
        "commands": [
            {
                "command": "snova.restartServer",
                "title": "Restart Language Server",
                "category": "Snovalang"
            },
            {
                "command": "snova.runFile",
                "title": "Run Current File (snl run)",
                "category": "Snovalang",
                "icon": "$(play)"
            },
            {
                "command": "snova.checkProject",
                "title": "Check Project (snl check)",
                "category": "Snovalang"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "resourceExtname == .snova",
                    "command": "snova.runFile",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Snovalang",
            "properties": {
                "snova.lsp.serverPath": {
                    "type": "string",
                    "default": "snova-lsp",
                    "description": "Path to snova-lsp binary executable"
                },
                "snova.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Traces communication between VS Code and Snovalang LSP"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0"
    },
    "devDependencies": {
        "@types/node": "^18.11.18",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.3.3"
    }
}
