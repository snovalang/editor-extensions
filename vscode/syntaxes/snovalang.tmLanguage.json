{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Snovalang",
    "scopeName": "source.snova",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#decorators" },
        { "include": "#functions" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.snova",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.snova",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.snova",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.snova",
                            "match": "\\\\.|\\$\\$"
                        },
                        {
                            "name": "meta.interpolation.snova",
                            "begin": "\\$\\{",
                            "end": "\\}",
                            "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.snova" } },
                            "endCaptures": { "0": { "name": "punctuation.section.embedded.end.snova" } },
                            "patterns": [{ "include": "$self" }]
                        }
                    ]
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "name": "string.quoted.single.snova",
                    "match": "'(?:\\\\.|[^'\\\\\\n])'",
                    "captures": {
                        "0": { "patterns": [{ "name": "constant.character.escape.snova", "match": "\\\\." }] }
                    }
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.snova",
                    "match": "\\b0[xX][0-9a-fA-F_]+[lL]?\\b"
                },
                {
                    "name": "constant.numeric.float.snova",
                    "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?[dD]?\\b"
                },
                {
                    "name": "constant.numeric.integer.snova",
                    "match": "\\b\\d[\\d_]*[lL]?\\b"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(?:data\\s+|abstract\\s+)?(class|struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.snova" },
                        "2": { "name": "entity.name.type.snova" }
                    }
                },
                {
                    "match": "\\b(func|method)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.snova" },
                        "2": { "name": "entity.name.function.snova" }
                    }
                },
                {
                    "match": "\\b(package|import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
                    "captures": {
                        "1": { "name": "keyword.other.import.snova" },
                        "2": { "name": "entity.name.namespace.snova" }
                    }
                },
                {
                    "match": "^\\s*(?:(?:public|private|protected)\\s+)?(extension|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.snova" },
                        "2": { "name": "entity.name.type.snova" }
                    }
                },
                {
                    "name": "keyword.declaration.constructor.snova",
                    "match": "\\bconstructor\\b(?=\\s*\\()"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "variable.language.this.snova",
                    "match": "\\bthis\\b"
                },
                {
                    "name": "constant.language.snova",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "keyword.control.snova",
                    "match": "\\b(if|else|while|for|in|match|return|break|continue|try|catch|finally|throw|defer|await)\\b"
                },
                {
                    "name": "keyword.declaration.snova",
                    "match": "\\b(package|import|class|struct|enum|interface|func|method|let|var|const|extension|extends|implements)\\b"
                },
                {
                    "name": "storage.modifier.snova",
                    "match": "\\b(public|private|protected|override|static|async|abstract|data|unsafe|sealed|final|open|internal)\\b"
                },
                {
                    "name": "keyword.other.snova",
                    "match": "\\b(pulsar|new|as|is|constructor)\\b"
                },
                {
                    "name": "keyword.other.accessor.snova",
                    "match": "\\b(get|set)(?=\\s*[:;,{])"
                },
                {
                    "name": "variable.language.wildcard.snova",
                    "match": "\\b_\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.snova",
                    "match": "\\b(int|int8|int16|int32|int64|int128|long|byte|double|float|decimal|string|char|bool|any|unit)\\b"
                },
                {
                    "name": "support.type.core.snova",
                    "match": "\\b(Option|Result|Partial|Array|Map|Channel|Console)\\b"
                },
                {
                    "name": "entity.name.type.snova",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "decorators": {
            "patterns": [
                {
                    "name": "entity.name.function.decorator.snova",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.snova",
                    "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.snova",
                    "match": "(\\?\\?|\\?\\.|->|~>|<~|=>|::|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|[-+*/%=<>!?&|^~])"
                }
            ]
        }
    }
}
