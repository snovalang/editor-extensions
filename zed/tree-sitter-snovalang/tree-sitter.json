{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "snovalang",
      "camelcase": "Snovalang",
      "scope": "source.snovalang",
      "path": ".",
      "file-types": [
        "snl",
        "sns"
      ],
      "injection-regex": "^snovalang$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for Snovalang",
    "authors": [
      {
        "name": "Snovalang Contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/sunjvm/sunjvm"
    }
  },
  "bindings": {
    "c": true
  }
}
